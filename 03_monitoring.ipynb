   "source": [
    "# 03 — Monitoring MD Simulations\n",
    "Real-time and post-hoc monitoring of GROMACS MD trajectories.\n",
    "Works with running or completed simulations.\n",
    "\n",
    "## What you can monitor\n",
    "- Energy, temperature, pressure, density (from .edr)\n",
    "- RMSD from starting structure\n",
    "- Progress bar for running simulations\n",
    "- Checkpoint recovery status"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Configuration — Edit these values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import subprocess\n",
    "import glob\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib\n",
    "matplotlib.rcParams['figure.dpi'] = 120\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "\n",
    "# ── Paths ────────────────────────────────────────────────────\n",
    "SIM_DIR = \"data/my_protein_md\"\n",
    "TOPOLOGY = \"data/my_protein_prep/topol.top\"\n",
    "\n",
    "# ── Which phase to monitor ───────────────────────────────────\n",
    "PHASE = \"prod\"     # \"nvt\", \"npt\", or \"prod\"\n",
    "\n",
    "# ── Monitoring parameters ────────────────────────────────────\n",
    "REFERENCE_STRUCTURE = \"data/my_protein_prep/em.gro\"\n",
    "\n",
    "def run_gmx(cmd, desc=\"\"):\n",
    "    if desc:\n",
    "        print(f\"  [{desc}]\")\n",
    "    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)\n",
    "    if result.returncode != 0:\n",
    "        print(f\"  stderr: {result.stderr[-200:]}\")\n",
    "    return result"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Simulation Progress\n",
    "Check how many steps have been completed and estimated time remaining."
   ]
  },
  {
   cell_type: "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "edr_files = glob.glob(f\"{SIM_DIR}/{PHASE}*.edr\")\n",
    "log_files = glob.glob(f\"{SIM_DIR}/{PHASE}*.log\")\n",
    "cpt_files = glob.glob(f\"{SIM_DIR}/{PHASE}*.cpt\")\n",
    "\n",
    "print(f\"EDR files: {[os.path.basename(f) for f in edr_files]}\")\n",
    "print(f\"Log files: {[os.path.basename(f) for f in log_files]}\")\n",
    "print(f\"Checkpoint files: {[os.path.basename(f) for f in cpt_files]}\")\n",
    "print()\n",
    "\n",
    "# Read log file for progress\n",
    "if log_files:\n",
    "    latest_log = sorted(log_files)[-1]\n",
    "    with open(latest_log) as f:\n",
    "        lines = f.readlines()[-50:]  # Last 50 lines\n",
    "    for line in lines[-10:]:\n",
    "        if any(kw in line for kw in ['Step', 'step', 'ns/day', 'hour', 'Performance', 'Time']):\n",
    "            print(f\"  {line.rstrip()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Energy plots\n",
    "Plot potential energy, temperature, pressure, and density from the energy file."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "edr_path = f\"{SIM_DIR}/{PHASE}.edr\" if os.path.exists(f\"{SIM_DIR}/{PHASE}.edr\") else (sorted(edr_files)[-1] if edr_files else None)\n",
    "xvg_dir = f\"{SIM_DIR}/xvg\"\n",
    "os.makedirs(xvg_dir, exist_ok=True)\n",
    "\n",
    "xvg_choices = {\n",
    "    'potential': '10',   # Potential\n",
    "    'temperature': '16', # Temperature\n",
    "    'pressure': '18',    # Pressure\n",
    "    'density': '24',     # Density\n",
    "}\n",
    "\n",
    "def plot_xvg(xvg_path, ylabel, title, color='steelblue', ylim=None):\n",
    "    import pandas as pd\n",
    "    if not os.path.exists(xvg_path):\n",
    "        return None\n",
    "    # Parse XVG (skip comments and @ directives)\n",
    "    data = []\n",
    "    with open(xvg_path) as f:\n",
    "        for line in f:\n",
    "            if line.strip() and not line.startswith('#') and not line.startswith('@'):\n",
    "                vals = line.strip().split()\n",
    "                if len(vals) >= 2:\n",
    "                    data.append(vals[:2])\n",
    "    data = np.array(data, dtype=float)\n",
    "    return data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "\n",
    "for ax, (name, choice) in zip(axes.flat, xvg_choices.items()):\n",
    "    xvg = f\"{xvg_dir}/{PHASE}_{name}.xvg\"\n",
    "    if not os.path.exists(xvg):\n",
    "        run_gmx(f\"echo -e '{choice}\\\\n0\\\\n' | gmx energy -f {edr_path} -o {xvg}\",\n",
    "                desc=f\"extract {name}\")\n",
    "    \n",
    "    data = plot_xvg(xvg, name, name)\n",
    "    if data is not None:\n",
    "        ax.plot(data[:, 0], data[:, 1], lw=0.5, color='steelblue')\n",
    "        # Running average\n",
    "        window = max(1, len(data) // 50)\n",
    "        if len(data) > window:\n",
    "            smooth = np.convolve(data[:, 1], np.ones(window)/window, mode='valid')\n",
    "            offset = (len(data) - len(smooth)) // 2\n",
    "            ax.plot(data[offset:offset+len(smooth), 0], smooth, 'r-', lw=1.5)\n",
    "        ax.set_xlabel('Time (ps)')\n",
    "        ax.set_ylabel(name.capitalize())\n",
    "        ax.set_title(f'{name.capitalize()} — {PHASE.upper()}')\n",
    "        ax.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{SIM_DIR}/{PHASE}_energy_summary.png\", dpi=120, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. RMSD monitoring\n",
    "For production runs, track RMSD from the reference structure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "xtc_path = f\"{SIM_DIR}/{PHASE}.xtc\"\n",
    "if os.path.exists(xtc_path) and os.path.exists(REFERENCE_STRUCTURE):\n",
    "    print(f\"Computing RMSD from {REFERENCE_STRUCTURE}...\")\n",
    "    \n",
    "    # Use GROMACS built-in RMSD\n",
    "    run_gmx(f\"echo -e '4\\\\n4\\\\n' | gmx rms -s {REFERENCE_STRUCTURE} -f {xtc_path} \"\n",
    "            f\"-o {xvg_dir}/{PHASE}_rmsd.xvg -tu ns\",\n",
    "            desc=\"compute RMSD\")\n",
    "    \n",
    "    if os.path.exists(f\"{xvg_dir}/{PHASE}_rmsd.xvg\"):\n",
    "        import pandas as pd\n",
    "        data = pd.read_csv(f\"{xvg_dir}/{PHASE}_rmsd.xvg\", comment='#', comment='@',\n",
    "                           delim_whitespace=True, header=None, names=['time_ns','rmsd_nm'])\n",
    "        data['rmsd_a'] = data['rmsd_nm'] * 10  # nm to Å\n",
    "        \n",
    "        plt.figure(figsize=(12, 4))\n",
    "        plt.plot(data['time_ns'], data['rmsd_a'], lw=0.5, color='darkgreen')\n",
    "        plt.axhline(data['rmsd_a'].mean(), color='red', ls='--', \n",
    "                    label=f\"Mean: {data['rmsd_a'].mean():.1f} Å\")\n",
    "        plt.fill_between(data['time_ns'], \n",
    "                         data['rmsd_a'].mean() - data['rmsd_a'].std(),\n",
    "                         data['rmsd_a'].mean() + data['rmsd_a'].std(),\n",
    "                         alpha=0.2, color='red')\n",
    "        plt.xlabel('Time (ns)')\n",
    "        plt.ylabel('RMSD (Å)')\n",
    "        plt.title(f'Backbone RMSD — {PHASE.upper()}')\n",
    "        plt.legend()\n",
    "        plt.grid(alpha=0.3)\n",
    "        plt.show()\n",
    "        \n",
    "        # Convergence check\n",
    "        half = len(data) // 2\n",
    "        rmsd_first = data['rmsd_a'].iloc[:half].mean()\n",
    "        rmsd_last = data['rmsd_a'].iloc[half:].mean()\n",
    "        print(f\"\\nFirst half mean RMSD: {rmsd_first:.2f} Å\")\n",
    "        print(f\"Second half mean RMSD: {rmsd_last:.2f} Å\")\n",
    "        if abs(rmsd_first - rmsd_last) < 0.5:\n",
    "            print(\"✓ Structure appears equilibrated (RMSD stable)\")\n",
    "        else:\n",
    "            print(\"! RMSD still drifting — consider extending the simulation\")\n",
    "else:\n",
    "    print(f\"Trajectory not found at {xtc_path} or reference missing.\")\n",
    "    print(\"This is expected if production hasn't started yet.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Radius of gyration (compactness)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if os.path.exists(xtc_path):\n",
    "    run_gmx(f\"echo -e '1\\\\n1\\\\n' | gmx gyrate -s {REFERENCE_STRUCTURE} -f {xtc_path} \"\n",
    "            f\"-o {xvg_dir}/{PHASE}_gyrate.xvg -tu ns\",\n",
    "            desc=\"compute Rg\")\n",
    "    \n",
    "    if os.path.exists(f\"{xvg_dir}/{PHASE}_gyrate.xvg\"):\n",
    "        data = []\n",
    "        with open(f\"{xvg_dir}/{PHASE}_gyrate.xvg\") as f:\n",
    "            for line in f:\n",
    "                if line.strip() and not line.startswith('#') and not line.startswith('@'):\n",
    "                    vals = line.strip().split()\n",
    "                    if len(vals) >= 2:\n",
    "                        data.append((float(vals[0]), float(vals[1])))\n",
    "        data = np.array(data)\n",
    "        \n",
    "        plt.figure(figsize=(12, 4))\n",
    "        plt.plot(data[:, 0], data[:, 1], lw=0.5, color='purple')\n",
    "        plt.xlabel('Time (ns)')\n",
    "        plt.ylabel('Rg (nm)')\n",
    "        plt.title('Radius of Gyration')\n",
    "        plt.grid(alpha=0.3)\n",
    "        plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Checkpoint & Recovery Status\n",
    "If the simulation crashed, restart from checkpoint."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cpt_path = f\"{SIM_DIR}/{PHASE}.cpt\"\n",
    "if os.path.exists(cpt_path):\n",
    "    run_gmx(f\"gmx check -f {cpt_path}\", desc=\"check checkpoint\")\n",
    "    print(\"To restart from checkpoint:\")\n",
    "    print(f\"  gmx mdrun -v -deffnm {SIM_DIR}/{PHASE} -s {SIM_DIR}/{PHASE}.tpr \\\\\")\n",
    "    print(f\"       -cpi {cpt_path} -gpu_id 0 -nb gpu -pme gpu -bonded cpu -update gpu\")\n",
    "elif not os.path.exists(xtc_path):\n",
    "    print(\"No checkpoint or trajectory found — simulation may not have started.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary\n",
    "- Energy plots saved to `{SIM_DIR}/{PHASE}_energy_summary.png`\n",
    "- XVG data in `{SIM_DIR}/xvg/` for custom plotting\n",
    "- Ready for `04_analysis.ipynb` for deeper trajectory analysis"
   ]
  }
 ]
}